+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QDeadlineTimer>
+#include <QHash>
+#include <QObject>
+#include <QTimer>
+#include <functional>
+
+namespace KWin
+{
+
+// Owns temporary output overrides. The callback must use normal backend commits.
+class ExperimentalHdrSessions : public QObject
+{
+    Q_OBJECT
+public:
+    using Apply = std::function<bool(const QString &output, bool enabled)>;
+    explicit ExperimentalHdrSessions(Apply apply, QObject *parent = nullptr, int timeoutMs = 5000);
+    QString acquire(const QString &owner, const QString &output);
+    bool renew(const QString &owner, const QString &token);
+    bool release(const QString &owner, const QString &token);
+    void removeOwner(const QString &owner);
+    void dropOutput(const QString &output);
+
+Q_SIGNALS:
+    void ownerActive(const QString &owner);
+    void ownerIdle(const QString &owner);
+
+private:
+    struct Lease
+    {
+        QString owner;
+        QString output;
+        QDeadlineTimer deadline;
+        bool releasing = false;
+    };
+    bool restore(const QString &token);
+    void erase(const QString &token);
+    void expire();
+    Apply m_apply;
+    const int m_timeoutMs;
+    QTimer m_timer;
+    QHash<QString, Lease> m_leases;
+};
+
+}
