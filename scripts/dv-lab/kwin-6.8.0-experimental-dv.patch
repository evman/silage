+bool DrmOutput::setExperimentalDvMetadata(bool enabled)
+{
+    if (!m_pipeline || !m_gpu->atomicModeSetting() || !m_connector->hdrMetadata.isValid()) {
+        return !enabled;
+    }
+    if (enabled && (!isEnabled() || !highDynamicRange() || !wideColorGamut() || lease()
+                    || !m_connector->connectorName().startsWith(QLatin1String("DP-"))
+                    || !matchesExperimentalHdrProfile(m_connector->edid()->raw()))) {
+        return false;
+    }
+    if (m_pipeline->experimentalDvMetadata() == enabled) {
+        return true;
+    }
+    m_pipeline->setExperimentalDvMetadata(enabled);
+    if (!DrmPipeline::commitPipelines({m_pipeline}, m_gpu, DrmPipeline::CommitMode::TestAllowModeset)) {
+        m_pipeline->revertPendingChanges();
+        return false;
+    }
+    m_pipeline->applyPendingChanges();
+    for (const auto &layer : m_pipeline->layers()) {
+        layer->addDeviceRepaint(Region::infinite());
+    }
+    m_renderLoop->scheduleRepaint();
+    return true;
+}
