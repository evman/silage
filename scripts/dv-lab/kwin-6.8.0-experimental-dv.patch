+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "experimental_hdr_sessions.h"
+#include <QUuid>
+#include <algorithm>
+#include <utility>
+
+namespace KWin
+{
+
+ExperimentalHdrSessions::ExperimentalHdrSessions(Apply apply, QObject *parent, int timeoutMs)
+    : QObject(parent)
+    , m_apply(std::move(apply))
+    , m_timeoutMs(std::max(1, timeoutMs))
+{
+    m_timer.setInterval(std::clamp(m_timeoutMs / 4, 10, 1000));
+    connect(&m_timer, &QTimer::timeout, this, &ExperimentalHdrSessions::expire);
+}
+
+QString ExperimentalHdrSessions::acquire(const QString &owner, const QString &output)
+{
+    if (!owner.startsWith(QLatin1Char(':')) || output.isEmpty()) {
+        return {};
+    }
+    for (const Lease &lease : std::as_const(m_leases)) {
+        if (lease.output == output) {
+            return {};
+        }
+    }
+    if (!m_apply(output, true)) {
+        return {};
+    }
+    const QString token = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    m_leases.insert(token, Lease{owner, output, QDeadlineTimer(m_timeoutMs)});
+    m_timer.start();
+    Q_EMIT ownerActive(owner);
+    return token;
+}
+
+bool ExperimentalHdrSessions::renew(const QString &owner, const QString &token)
+{
+    auto it = m_leases.find(token);
+    if (it == m_leases.end() || it->owner != owner || it->releasing) {
+        return false;
+    }
+    if (it->deadline.hasExpired()) {
+        restore(token);
+        return false;
+    }
+    it->deadline = QDeadlineTimer(m_timeoutMs);
+    return true;
+}
+
+bool ExperimentalHdrSessions::release(const QString &owner, const QString &token)
+{
+    const auto it = m_leases.constFind(token);
+    return it != m_leases.cend() && it->owner == owner && restore(token);
+}
+
+void ExperimentalHdrSessions::erase(const QString &token)
+{
+    const QString owner = m_leases.take(token).owner;
+    const bool ownerStillActive = std::ranges::any_of(m_leases, [&owner](const Lease &lease) {
+        return lease.owner == owner;
+    });
+    if (!ownerStillActive) {
+        Q_EMIT ownerIdle(owner);
+    }
+    if (m_leases.isEmpty()) {
+        m_timer.stop();
+    }
+}
+
+bool ExperimentalHdrSessions::restore(const QString &token)
+{
+    auto it = m_leases.find(token);
+    if (it == m_leases.end()) {
+        return true;
+    }
+    it->releasing = true;
+    if (!m_apply(it->output, false)) {
+        // Keep ownership and retry; another client must not inherit a stale override.
+        return false;
+    }
+    erase(token);
+    return true;
+}
+
+void ExperimentalHdrSessions::removeOwner(const QString &owner)
+{
+    for (const QString &token : m_leases.keys()) {
+        if (m_leases.value(token).owner == owner) {
+            restore(token);
+        }
+    }
+}
+
+void ExperimentalHdrSessions::dropOutput(const QString &output)
+{
+    for (const QString &token : m_leases.keys()) {
+        if (m_leases.value(token).output == output) {
+            // The output is gone. Never replay an old override onto its replacement.
+            erase(token);
+        }
+    }
+}
+
+void ExperimentalHdrSessions::expire()
+{
+    for (const QString &token : m_leases.keys()) {
+        const Lease &lease = m_leases[token];
+        if (lease.releasing || lease.deadline.hasExpired()) {
+            restore(token);
+        }
+    }
+}
+
+}
