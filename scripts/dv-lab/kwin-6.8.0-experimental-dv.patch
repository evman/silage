diff --git a/src/backends/drm/experimental_hdr_profile.h b/src/backends/drm/experimental_hdr_profile.h
new file mode 100644
index 0000000..9ccc006
--- /dev/null
+++ b/src/backends/drm/experimental_hdr_profile.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QByteArrayView>
+#include <libdrm/drm_mode.h>
+
+namespace KWin
+{
+
+// Prototype profile: exact Dolby capability block observed on the tested monitor.
+inline bool matchesExperimentalHdrProfile(QByteArrayView edid)
+{
+    constexpr unsigned char header[] = {0, 255, 255, 255, 255, 255, 255, 0};
+    constexpr unsigned char capability[] = {1, 0x46, 0xd0, 0, 0x4c, 2, 0x5d, 0x89, 0x60, 0x6f, 0x87};
+    if (edid.size() < 128 || edid.size() != (static_cast<unsigned char>(edid[126]) + 1) * 128) {
+        return false;
+    }
+    const auto bytes = reinterpret_cast<const unsigned char *>(edid.data());
+    for (int i = 0; i < 8; i++) {
+        if (bytes[i] != header[i]) {
+            return false;
+        }
+    }
+    int matches = 0;
+    for (qsizetype start = 0; start < edid.size(); start += 128) {
+        unsigned char sum = 0;
+        for (int i = 0; i < 128; i++) {
+            sum += bytes[start + i];
+        }
+        if (sum != 0) {
+            return false;
+        }
+        const unsigned char *block = bytes + start;
+        if (start == 0 || block[0] != 2 || block[1] < 3 || block[2] == 0) {
+            continue;
+        }
+        if (block[2] < 4 || block[2] > 127) {
+            return false;
+        }
+        for (int pos = 4; pos < block[2];) {
+            const int size = block[pos] & 31;
+            if (pos + 1 + size > block[2]) {
+                return false;
+            }
+            if ((block[pos] >> 5) == 7 && size == sizeof(capability)) {
+                bool equal = true;
+                for (int i = 0; i < size; i++) {
+                    equal &= block[pos + 1 + i] == capability[i];
+                }
+                matches += equal;
+            }
+            pos += size + 1;
+        }
+    }
+    return matches == 1;
+}
+
+inline hdr_output_metadata experimentalHdrProfile()
+{
+    // NVAPI GET capture, 2026-10-19. Not a general Dolby signaling specification.
+    return hdr_output_metadata{
+        .metadata_type = 0,
+        .hdmi_metadata_type1 = hdr_metadata_infoframe{
+            .eotf = 2,
+            .metadata_type = 0,
+            .display_primaries = {{35366, 14710}, {8456, 39806}, {6650, 2118}},
+            .white_point = {15854, 16432},
+            .max_display_mastering_luminance = 1000,
+            .min_display_mastering_luminance = 0,
+            .max_cll = 1022,
+            .max_fall = 938,
+        },
+    };
+}
+
+}
