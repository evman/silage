diff --git a/autotests/experimentalhdr/test_experimental_hdr.cpp b/autotests/experimentalhdr/test_experimental_hdr.cpp
new file mode 100644
index 0000000..0968bb1
--- /dev/null
+++ b/autotests/experimentalhdr/test_experimental_hdr.cpp
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "experimental_hdr_sessions.h"
+#include "experimental_hdr_profile.h"
+#include <QSignalSpy>
+#include <QTest>
+
+using namespace KWin;
+
+class TestExperimentalHdr : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void ownershipAndBusyOutput()
+    {
+        QHash<QString, bool> applied;
+        ExperimentalHdrSessions sessions([&](const QString &output, bool enabled) {
+            applied[output] = enabled;
+            return true;
+        });
+        const auto token = sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        QVERIFY(!token.isEmpty());
+        QVERIFY(applied.value(QStringLiteral("DP-3")));
+        QVERIFY(sessions.acquire(QStringLiteral(":1.2"), QStringLiteral("DP-3")).isEmpty());
+        QVERIFY(!sessions.renew(QStringLiteral(":1.2"), token));
+        QVERIFY(!sessions.release(QStringLiteral(":1.2"), token));
+        QVERIFY(applied.value(QStringLiteral("DP-3")));
+        QVERIFY(sessions.release(QStringLiteral(":1.1"), token));
+        QVERIFY(!applied.value(QStringLiteral("DP-3")));
+    }
+
+    void unsupportedOutputDoesNotGetSession()
+    {
+        ExperimentalHdrSessions sessions([](const QString &, bool) { return false; });
+        QVERIFY(sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3")).isEmpty());
+        QVERIFY(!sessions.renew(QStringLiteral(":1.1"), QStringLiteral("missing")));
+    }
+
+    void expiryRestoresOutput()
+    {
+        bool applied = false;
+        ExperimentalHdrSessions sessions([&](const QString &, bool enabled) {
+            applied = enabled;
+            return true;
+        }, nullptr, 40);
+        const auto token = sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        QVERIFY(applied);
+        QTRY_VERIFY_WITH_TIMEOUT(!applied, 500);
+        QVERIFY(!sessions.renew(QStringLiteral(":1.1"), token));
+    }
+
+    void heartbeatAndLateRenewal()
+    {
+        bool applied = false;
+        ExperimentalHdrSessions sessions([&](const QString &, bool enabled) {
+            applied = enabled;
+            return true;
+        }, nullptr, 120);
+        const auto token = sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        QTest::qWait(60);
+        QVERIFY(sessions.renew(QStringLiteral(":1.1"), token));
+        QTest::qWait(80);
+        QVERIFY(applied);
+        // Even if the timer couldn't run, an expired deadline cannot be renewed.
+        QTest::qSleep(60);
+        QVERIFY(!sessions.renew(QStringLiteral(":1.1"), token));
+        QVERIFY(!applied);
+    }
+
+    void disconnectRestoresOnlyOwnersOutputs()
+    {
+        QHash<QString, bool> applied;
+        ExperimentalHdrSessions sessions([&](const QString &output, bool enabled) {
+            applied[output] = enabled;
+            return true;
+        });
+        sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-1"));
+        const auto other = sessions.acquire(QStringLiteral(":1.2"), QStringLiteral("DP-2"));
+        sessions.removeOwner(QStringLiteral(":1.1"));
+        QVERIFY(!applied.value(QStringLiteral("DP-3")));
+        QVERIFY(!applied.value(QStringLiteral("DP-1")));
+        QVERIFY(applied.value(QStringLiteral("DP-2")));
+        QVERIFY(sessions.release(QStringLiteral(":1.2"), other));
+    }
+
+    void failedRestoreRetainsOwnershipAndRetries()
+    {
+        bool applied = false;
+        bool failRestore = true;
+        ExperimentalHdrSessions sessions([&](const QString &, bool enabled) {
+            if (!enabled && failRestore) {
+                return false;
+            }
+            applied = enabled;
+            return true;
+        }, nullptr, 40);
+        const auto token = sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        QVERIFY(!sessions.release(QStringLiteral(":1.1"), token));
+        QVERIFY(applied);
+        QVERIFY(!sessions.renew(QStringLiteral(":1.1"), token));
+        QVERIFY(sessions.acquire(QStringLiteral(":1.2"), QStringLiteral("DP-3")).isEmpty());
+        failRestore = false;
+        QTRY_VERIFY_WITH_TIMEOUT(!applied, 500);
+        QVERIFY(!sessions.acquire(QStringLiteral(":1.2"), QStringLiteral("DP-3")).isEmpty());
+    }
+
+    void unplugDoesNotReplayOldOverride()
+    {
+        int restores = 0;
+        ExperimentalHdrSessions sessions([&](const QString &, bool enabled) {
+            restores += !enabled;
+            return true;
+        });
+        const auto old = sessions.acquire(QStringLiteral(":1.1"), QStringLiteral("DP-3"));
+        sessions.dropOutput(QStringLiteral("DP-3"));
+        QVERIFY(!sessions.release(QStringLiteral(":1.1"), old));
+        QCOMPARE(restores, 0);
+        QVERIFY(!sessions.acquire(QStringLiteral(":1.2"), QStringLiteral("DP-3")).isEmpty());
+    }
+
+    void metadataMatchesWorkingCapture()
+    {
+        const auto metadata = experimentalHdrProfile();
+        static_assert(sizeof(metadata) == 32);
+        QCOMPARE(QByteArray(reinterpret_cast<const char *>(&metadata), 30).toHex(),
+                 QByteArray("000000000200268a763908217e9bfa194608ee3d3040e8030000fe03aa03"));
+    }
+
+    void validatesWholeEdidBeforeAllowingProfile()
+    {
+        QByteArray edid(256, '\0');
+        const auto header = QByteArray::fromHex("00ffffffffffff00");
+        std::copy(header.begin(), header.end(), edid.begin());
+        edid[126] = 1;
+        const auto cta = QByteArray::fromHex("02031000eb0146d0004c025d89606f87");
+        std::copy(cta.begin(), cta.end(), edid.begin() + 128);
+        auto checksum = [&edid](int offset) {
+            unsigned char sum = 0;
+            for (int i = 0; i < 127; i++) {
+                sum += static_cast<unsigned char>(edid[offset + i]);
+            }
+            edid[offset + 127] = -sum;
+        };
+        checksum(0); checksum(128);
+        QVERIFY(matchesExperimentalHdrProfile(edid));
+        QByteArray corrupt = edid;
+        corrupt[255] ^= 1;
+        QVERIFY(!matchesExperimentalHdrProfile(corrupt));
+        QVERIFY(!matchesExperimentalHdrProfile(QByteArrayView(edid).first(128)));
+        edid[130] = 8;
+        checksum(128);
+        QVERIFY(!matchesExperimentalHdrProfile(edid));
+    }
+};
+
+QTEST_GUILESS_MAIN(TestExperimentalHdr)
+#include "test_experimental_hdr.moc"
