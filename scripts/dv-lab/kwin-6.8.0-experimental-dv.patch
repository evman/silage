new file mode 100644
index 0000000..17c0393
--- /dev/null
+++ b/src/backends/drm/experimental_hdr_control.cpp
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "experimental_hdr_control.h"
+#include "drm_backend.h"
+#include "drm_output.h"
+#include <QDBusConnection>
+#include <QDBusError>
+#include <QDBusMessage>
+
+namespace KWin
+{
+
+ExperimentalHdrControl::ExperimentalHdrControl(DrmBackend *backend)
+    : QObject(backend)
+    , m_sessions([backend](const QString &name, bool enabled) {
+        for (BackendOutput *output : backend->outputs()) {
+            if (auto drm = qobject_cast<DrmOutput *>(output); drm && drm->name() == name) {
+                return drm->setExperimentalDvMetadata(enabled);
+            }
+        }
+        // If an output disappeared, no old profile may be applied to its replacement.
+        return !enabled;
+    })
+{
+    m_watcher.setConnection(QDBusConnection::sessionBus());
+    m_watcher.setWatchMode(QDBusServiceWatcher::WatchForUnregistration);
+    connect(&m_watcher, &QDBusServiceWatcher::serviceUnregistered, &m_sessions, &ExperimentalHdrSessions::removeOwner);
+    connect(&m_sessions, &ExperimentalHdrSessions::ownerActive, &m_watcher, &QDBusServiceWatcher::addWatchedService);
+    connect(&m_sessions, &ExperimentalHdrSessions::ownerIdle, &m_watcher, &QDBusServiceWatcher::removeWatchedService);
+    connect(backend, &DrmBackend::outputAdded, this, [this](BackendOutput *output) {
+        if (auto drm = qobject_cast<DrmOutput *>(output)) {
+            watchOutput(drm);
+        }
+    });
+    connect(backend, &DrmBackend::outputRemoved, this, [this](BackendOutput *output) {
+        m_sessions.dropOutput(output->name());
+    });
+    for (BackendOutput *output : backend->outputs()) {
+        if (auto drm = qobject_cast<DrmOutput *>(output)) {
+            watchOutput(drm);
+        }
+    }
+    QDBusConnection::sessionBus().registerObject(QStringLiteral("/dev/silage/KWin/HdrMetadata1"), this,
+        QDBusConnection::ExportScriptableSlots | QDBusConnection::ExportScriptableProperties);
+}
+
+void ExperimentalHdrControl::watchOutput(DrmOutput *output)
+{
+    const auto releaseIfUnavailable = [this, output] {
+        if (!output->isEnabled() || !output->highDynamicRange() || !output->wideColorGamut()) {
+            // Clear backend state before forgetting the sessions.
+            if (output->setExperimentalDvMetadata(false)) {
+                m_sessions.dropOutput(output->name());
+            }
+        }
+    };
+    connect(output, &BackendOutput::enabledChanged, this, releaseIfUnavailable);
+    connect(output, &BackendOutput::highDynamicRangeChanged, this, releaseIfUnavailable);
+    connect(output, &BackendOutput::wideColorGamutChanged, this, releaseIfUnavailable);
+}
+
+QString ExperimentalHdrControl::acquire(const QString &outputName)
+{
+    if (!calledFromDBus()) {
+        return {};
+    }
+    const QString token = m_sessions.acquire(message().service(), outputName);
+    if (token.isEmpty()) {
+        sendErrorReply(QDBusError::NotSupported, QStringLiteral("Output unavailable, busy, or unsupported by the experimental profile"));
+    }
+    return token;
+}
+
+bool ExperimentalHdrControl::renew(const QString &token)
+{
+    return calledFromDBus() && m_sessions.renew(message().service(), token);
+}
+
+bool ExperimentalHdrControl::release(const QString &token)
+{
+    return calledFromDBus() && m_sessions.release(message().service(), token);
+}
+
+}
