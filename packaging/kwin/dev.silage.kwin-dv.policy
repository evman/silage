<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Silage</vendor>
  <action id="dev.silage.kwin-dv">
    <description>Install or remove KWin with Dolby Vision support</description>
    <message>Authentication is required to install or remove Silage's Dolby Vision version of KWin.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/silage-kwin-dv/silage-kwin-dv</annotate>
  </action>
</policyconfig>
