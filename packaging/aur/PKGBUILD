# Maintainer: evman <evman311 at gmail dot com>
pkgname=silage-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="An unofficial Silo client for Linux: a fullscreen home-theater app for Silo media servers"
arch=('x86_64')
url="https://github.com/evman/silage"
license=('AGPL-3.0-or-later')
# mpv is loaded at runtime (dlopen); the rest are linked by the bundled Java runtime and Skia.
depends=('mpv' 'python' 'polkit' 'intel-gpu-tools' 'libdrm' 'hicolor-icon-theme' 'libx11' 'libxext' 'libxrender' 'libxtst' 'libxi' 'fontconfig' 'libglvnd' 'alsa-lib')
provides=('silage')
conflicts=('silage')
# The bundled Java runtime ships prebuilt native libraries.
options=('!strip' '!debug')
# pacman versions can't contain '-': a prerelease tag v0.5.0-rc.1 is pkgver 0.5.0_rc.1.
source=("$url/releases/download/v${pkgver//_/-}/silage-${pkgver//_/-}-linux-x86_64.tar.gz")
# The release workflow writes the exact tarball checksum in its published PKGBUILD.
sha256sums=('fac3e9d37cb78ad37bb9b7fcbce85710d7389f6910632940b6d413d58e28a103')

package() {
  cd "silage-${pkgver//_/-}"
  install -d "$pkgdir/opt" "$pkgdir/usr/bin" "$pkgdir/usr/share"
  cp -a silage "$pkgdir/opt/silage"
  install -Dm755 silage/lib/app/dv-helper/silage-dv-helper "$pkgdir/usr/libexec/silage-dv-helper/silage-dv-helper"
  install -Dm755 silage/lib/app/dv-helper/kms-snapshot "$pkgdir/usr/libexec/silage-dv-helper/kms-snapshot"
  install -Dm644 silage/lib/app/dv-helper/dev.silage.dv-helper.policy "$pkgdir/usr/share/polkit-1/actions/dev.silage.dv-helper.policy"
  ln -s /opt/silage/bin/silage "$pkgdir/usr/bin/silage"
  install -Dm644 dev.silage.Silage.desktop "$pkgdir/usr/share/applications/dev.silage.Silage.desktop"
  install -Dm644 dev.silage.Silage.metainfo.xml "$pkgdir/usr/share/metainfo/dev.silage.Silage.metainfo.xml"
  cp -a icons "$pkgdir/usr/share/icons"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
